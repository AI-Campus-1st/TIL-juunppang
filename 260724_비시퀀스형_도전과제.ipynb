   "source": [
    "# 도전! 최대 & 최소 찾기(min & max 쓰지 않고!)\n",
    "my_list = [3, 2, 10, 2, 4]\n",
    "\n",
    "min = my_list[0]\n",
    "max = my_list[0]\n",
    "for i in my_list:\n",
    "    if i < min:\n",
    "        min = i\n",
    "    if i > max:\n",
    "        max = i\n",
    "print(min)\n",
    "print(max)\n",
    "\n",
    "print(f'my_list의 최댓값은 {max}이며, 최솟값은{min}이다.')"
   ]
  }
 ],
